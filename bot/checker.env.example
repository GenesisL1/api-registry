# Copy to /etc/genesis-api-checker.env, chmod 600, owned by root.
# systemd reads it with EnvironmentFile=; the checker user never sees the file.

REGISTRY_ADDRESS=0xREPLACE
LENS_ADDRESS=0xREPLACE
RPC_URL=https://rpc.genesisl1.org
CHAIN_ID=29
COSMOS_CHAIN_ID=genesis_29-2
CHECKER_NAME=example-operator

# Only set this if this checker is authorized to attest on-chain. A read-only
# checker publishes telemetry without a key and needs no funds.
# CHECKER_PRIVATE_KEY=0x...

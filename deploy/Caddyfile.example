# Caddy in front of the checker. TLS is automatic.
#
# The telemetry feed and its signature must be readable cross-origin: any
# directory instance, on any domain, verifies this feed before trusting it.

registry.example.org {
	encode zstd gzip
	root * /opt/genesis-api/web

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src *; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	@telemetry path /data/status*.json /data/status*.json.sig
	header @telemetry {
		Access-Control-Allow-Origin "*"
		Cache-Control               "no-cache, must-revalidate"
	}

	@immutable path /vendor/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	file_server
	rate_limit {
		zone directory {
			key    {remote_host}
			events 120
			window 1m
		}
	}
}
